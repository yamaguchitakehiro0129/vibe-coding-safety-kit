# このファイルは .env のテンプレートである。
# 実際の値を入れたファイルは .env として保存し、
# .gitignore に追加してリポジトリに含めない。

# ---------------------------------------------
# アプリケーション基本設定
# ---------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ---------------------------------------------
# データベース
# ---------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ---------------------------------------------
# 認証
# ---------------------------------------------
# 32文字以上のランダム文字列を使う
# 開発・ステージング・本番で別の値にすること
SESSION_SECRET=
JWT_SECRET=

# ---------------------------------------------
# 外部サービス（例：必要に応じて削除・追加する）
# ---------------------------------------------
# OpenAI / Anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# ---------------------------------------------
# メール送信
# ---------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------
# ログ・監視
# ---------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info

# ---------------------------------------------
# 注意事項
# ---------------------------------------------
# 1. すべての値は、開発・ステージング・本番で別にする
# 2. 本番のシークレットは、SaaSのシークレット管理機能に入れる
# 3. このファイル（.env.example）はGitに含めてよい
# 4. 実際の値が入った .env は、絶対にGitに含めない
